{
    "name": "moderntribe\/tribe-alerts",
    "description": "Tribe Alerts WordPress Plugin",
    "type": "wordpress-plugin",
    "homepage": "https:\/\/github.com\/moderntribe\/tribe-alerts",
    "keywords": [
        "Modern Tribe",
        "tribe-alerts"
    ],
    "authors": [
        {
            "name": "Modern Tribe",
            "email": "admin@tri.be",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:nickforddesign\/acf-swatch.git"
        },
        {
            "type": "composer",
            "url": "https:\/\/connect.advancedcustomfields.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-json": "*",
        "ext-readline": "*",
        "enshrined\/svg-sanitize": "^0.22",
        "johnbillion\/extended-cpts": "^5.1",
        "league\/plates": "^3.6",
        "moderntribe\/tribe-libs": "^5.0",
        "spatie\/data-transfer-object": "^2.8"
    },
    "require-dev": {
        "behat\/gherkin": ">=4.4 <4.12",
        "codeception\/module-asserts": "^1.3.1",
        "codeception\/module-cli": "^1.1.1",
        "codeception\/module-db": "^1.2",
        "codeception\/module-filesystem": "^1.0.3",
        "codeception\/module-phpbrowser": "^1.0.3",
        "codeception\/module-webdriver": "^1.4.1",
        "codeception\/util-universalframework": "^1.0",
        "composer\/installers": "^2.0",
        "larapack\/dd": "^1.1",
        "lucatume\/function-mocker": "^2.0",
        "lucatume\/wp-browser": "^3.2",
        "moderntribe\/coding-standards": "^3.0",
        "nickford\/acf-swatch": "^1.0",
        "wpengine\/advanced-custom-fields-pro": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "Tribe\\Alert\\": "src"
        },
        "files": [
            "src\/functions.php",
            "vendor\/php-di\/php-di\/src\/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tribe\\Alert_Scoped\\Tribe\\Tests\\": "dev\/tests\/tests\/_support\/Classes\/",
            "Tribe\\Alert_Scoped\\Tribe\\Tests\\Traits\\": "dev\/tests\/tests\/_support\/Traits\/"
        }
    },
    "scripts": {
        "lint": "vendor\/bin\/phpcs --standard=phpcs.xml.dist",
        "format": "vendor\/bin\/phpcbf --standard=phpcs.xml.dist"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "ffraenz\/private-composer-installer": true,
            "composer\/installers": true,
            "cweagans\/composer-patches": true,
            "dealerdirect\/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "installer-paths": {
            "dev\/public\/wp-content\/plugins\/{$name}": [
                "type:wordpress-plugin"
            ]
        }
    }
}