/* -------------------------------------------------------------------------
 *
 * Aspect Ratio Helpers
 *
 * Use these helpers where block aspect ratio controls aren't available.
 *
 * Example:
 * <figure class="wp-block-image aspect-ratio-4-5 aspect-ratio-cover">
 *     <img class="wp-post-image" src="..."></img>
 * </figure>
 *
 * ------------------------------------------------------------------------- */

.aspect-ratio-cover {
	width: 100%;
	height: auto;
	object-fit: cover;

	> img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
}

.aspect-ratio-cover--custom {
	position: relative;

	> img {
		position: absolute;
		inset: 0;
	}
}

.aspect-ratio-1 {
	aspect-ratio: var(--aspect-ratio-1);
}

.aspect-ratio-5-4 {
	aspect-ratio: var(--aspect-ratio-5-4);
}

.aspect-ratio-4-3 {
	aspect-ratio: var(--aspect-ratio-4-3);
}

.aspect-ratio-3-2 {
	aspect-ratio: var(--aspect-ratio-3-2);
}

.aspect-ratio-16-10 {
	aspect-ratio: var(--aspect-ratio-16-10);
}

.aspect-ratio-16-9 {
	aspect-ratio: var(--aspect-ratio-16-9);
}

.aspect-ratio-2-1 {
	aspect-ratio: var(--aspect-ratio-2-1);
}

.aspect-ratio-21-9 {
	aspect-ratio: var(--aspect-ratio-21-9);
}

.aspect-ratio-3-1 {
	aspect-ratio: var(--aspect-ratio-3-1);
}

.aspect-ratio-4-5 {
	aspect-ratio: var(--aspect-ratio-4-5);
}

.aspect-ratio-3-4 {
	aspect-ratio: var(--aspect-ratio-3-4);
}

.aspect-ratio-2-3 {
	aspect-ratio: var(--aspect-ratio-2-3);
}

.aspect-ratio-9-16 {
	aspect-ratio: var(--aspect-ratio-9-16);
}

.aspect-ratio-1-2 {
	aspect-ratio: var(--aspect-ratio-1-2);
}
