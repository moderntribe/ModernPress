/* -------------------------------------------------------------------------
 *
 * Variables: Media
 *
 * ------------------------------------------------------------------------- */

:root {

	/* -------------------------------------------------------------------------
	 * Aspect Ratios
	 * ------------------------------------------------------------------------- */

	--aspect-ratio-1: var(--wp--preset--aspect-ratio--1-1, 1 / 1);
	--aspect-ratio-4-3: var(--wp--preset--aspect-ratio--4-3, 4 / 3);
	--aspect-ratio-3-4: var(--wp--preset--aspect-ratio--3-4, 3 / 4);
	--aspect-ratio-3-2: var(--wp--preset--aspect-ratio--3-2, 3 / 2);
	--aspect-ratio-2-3: var(--wp--preset--aspect-ratio--2-3, 2 / 3);
	--aspect-ratio-16-9: var(--wp--preset--aspect-ratio--16-9, 16 / 9);
	--aspect-ratio-9-16: var(--wp--preset--aspect-ratio--9-16, 9 / 16);
	--aspect-ratio-5-4: var(--wp--preset--aspect-ratio--5-4, 5 / 4);
	--aspect-ratio-16-10: var(--wp--preset--aspect-ratio--16-10, 16 / 10);
	--aspect-ratio-2-1: var(--wp--preset--aspect-ratio--2-1, 2 / 1);
	--aspect-ratio-21-9: var(--wp--preset--aspect-ratio--21-9, 21 / 9);
	--aspect-ratio-3-1: var(--wp--preset--aspect-ratio--3-1, 3 / 1);
	--aspect-ratio-4-5: var(--wp--preset--aspect-ratio--4-5, 4 / 5);
	--aspect-ratio-1-2: var(--wp--preset--aspect-ratio--1-2, 1 / 2);

}
