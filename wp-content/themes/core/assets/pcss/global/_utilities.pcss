/* -------------------------------------------------------------------------
 *
 * Utility Classes: Global
 *
 * ------------------------------------------------------------------------- */

/* -------------------------------------------------------------------------
 * Screen Reader Text
 * Visually hide content while keeping it available to assistive tech.
 * Matches WordPress core's .screen-reader-text convention.
 * ------------------------------------------------------------------------- */

.screen-reader-only {
	border: 0;
	clip-path: inset(50%);
	height: 1px;
	margin: -1px;
	overflow: hidden;
	padding: 0;
	position: absolute;
	width: 1px;
	word-wrap: normal !important;
}
