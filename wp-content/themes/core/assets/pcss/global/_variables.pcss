/* -------------------------------------------------------------------------
 *
 * Variables: Color
 *
 * ------------------------------------------------------------------------- */

:root {

	/* -----------------------------------------------------------------------
	 * Border Radius
	 * ----------------------------------------------------------------------- */

	--border-radius-10: var(--wp--preset--border-radius--10);
	--border-radius-20: var(--wp--preset--border-radius--20);
	--border-radius-30: var(--wp--preset--border-radius--30);
	--border-radius-40: var(--wp--preset--border-radius--40);
	--border-radius-full: var(--wp--preset--border-radius--full);

}
