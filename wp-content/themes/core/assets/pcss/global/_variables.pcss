/* -------------------------------------------------------------------------
 *
 * Variables: Color
 *
 * ------------------------------------------------------------------------- */

:root {

	/* -----------------------------------------------------------------------
	 * Border Radius
	 * ----------------------------------------------------------------------- */

	--border-radius-s: var(--wp--preset--border-radius--s);
	--border-radius-m: var(--wp--preset--border-radius--m);
	--border-radius-l: var(--wp--preset--border-radius--l);
	--border-radius-xl: var(--wp--preset--border-radius--xl);
	--border-radius-full: var(--wp--preset--border-radius--full);

}
