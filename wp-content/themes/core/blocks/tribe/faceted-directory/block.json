{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tribe/faceted-directory",
	"version": "0.1.0",
	"title": "Faceted Directory",
	"category": "theme",
	"icon": "welcome-widgets-menus",
	"description": "A faceted archive with filter bar and results grid",
	"attributes": {
		"filterBarPosition": {
			"type": "string",
			"default": "top",
			"enum": [ "top", "sidebar" ]
		},
		"postTypes": {
			"type": "array",
			"default": [ "post" ]
		}
	},
	"providesContext": {
		"tribe/faceted-directory/filterBarPosition": "filterBarPosition",
		"tribe/faceted-directory/postTypes": "postTypes"
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "tribe",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
