{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tribe/directory-grid",
	"version": "0.1.0",
	"title": "Directory Grid",
	"category": "theme",
	"icon": "archive",
	"description": "Results grid for a Faceted Directory",
	"attributes": {
		"postsPerPage": {
			"type": "number",
			"default": 12
		},
		"showPagination": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"tribe/faceted-directory/postTypes"
	],
	"supports": {
		"html": false,
		"align": [ "wide", "grid", "full" ],
		"inserter": false,
		"spacing": {
			"margin": false,
			"padding": false
		}
	},
	"textdomain": "tribe",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
