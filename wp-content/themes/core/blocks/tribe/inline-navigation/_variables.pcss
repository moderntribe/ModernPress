/* -------------------------------------------------------------------------
 *
 * Block - Inline Navigation - Variables
 *
 * ------------------------------------------------------------------------- */

:root,
:--light-themes {
	--inline-navigation-active-link: var(--color-blue);
	--inline-navigation-flyout-background: var(--color-white);
	--inline-navigation-flyout-shadow: var(--color-black-20);
}

:--dark-themes {
	--inline-navigation-active-link: var(--color-white);
	--inline-navigation-flyout-background: var(--color-neutral-90);
	--inline-navigation-flyout-shadow: var(--color-white-20);
}

:--brand-theme {
	--inline-navigation-active-link: var(--color-white);
	--inline-navigation-flyout-background: var(--color-blue);
}
