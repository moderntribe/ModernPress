{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tribe/filter-bar",
	"version": "1.0.0",
	"title": "Filter Bar",
	"category": "theme",
	"icon": "admin-settings",
	"description": "Facet controls for a Faceted Directory",
	"attributes": {
		"facets": {
			"type": "array",
			"default": []
		}
	},
	"usesContext": [
		"tribe/faceted-directory/filterBarPosition",
		"tribe/faceted-directory/postTypes"
	],
	"supports": {
		"html": false,
		"align": [ "wide", "grid", "full" ],
		"inserter": false,
		"spacing": {
			"margin": false,
			"padding": false
		}
	},
	"textdomain": "tribe",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
