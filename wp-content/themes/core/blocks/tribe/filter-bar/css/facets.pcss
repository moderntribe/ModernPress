/* -------------------------------------------------------------------------
 *
 * Block - Filter Bar - Facet Styles
 *
 * ------------------------------------------------------------------------- */

.tribe-facet__list {
	display: flex;
	flex-direction: column;
	gap: var(--spacer-20);
	margin: 0;
	padding: 0;
	list-style: none;
}

/*
 * Hierarchical facets set --facet-depth per item; flat ones leave it at 0.
 * The option filter hides items outright, hence the explicit display rule.
 */
.tribe-facet__item {
	padding-inline-start: calc(var(--facet-depth, 0) * var(--filter-bar-facet-indent));

	&[hidden] {
		display: none;
	}
}

.tribe-facet__reset-button,
.tribe-facet__clear {
	padding: 0;
	border: 0;
	background: none;
	cursor: pointer;
}

.tribe-facet__clear {
	margin-top: var(--spacer-20);
}

/* -------------------------------------------------------------------------
 * Filter Bar - Checkbox Facets
 * ------------------------------------------------------------------------- */

.tribe-facet--checkboxes {

	.tribe-facet__label {
		position: relative;
		cursor: pointer;
		padding-left: calc(24px + var(--spacer-10));

		&::before {

			@mixin facet-checkbox-box;
			position: absolute;
			top: 0;
			left: 0;
			border-radius: 0;
		}

		@media (--has-hover) {

			&:hover {

				@mixin facet-checkbox-hover-focus;
			}
		}

		&:focus-within {

			@mixin facet-checkbox-hover-focus;
		}

		&:has(input[type="checkbox"]:checked) {

			&::before {

				@mixin facet-checkbox-box-checked;
			}

			&::after {

				@mixin facet-checkbox-check;
				top: 5px;
				left: 4px;
			}

			.tribe-facet__label-text {
				font-weight: var(--font-weight-bold);
			}
		}
	}
}

/* -------------------------------------------------------------------------
 * Filter Bar - Search Facet
 * ------------------------------------------------------------------------- */

.tribe-facet--search {

	@mixin facet-search-field;
	--icon-size: 24px;

	.tribe-facet__search-input {
		width: 100%;
		height: 50px;
		padding: 0 calc(var(--spacer-20) * 2 + var(--icon-size)) 0 var(--spacer-20);
		border: 1px solid transparent;
		border-radius: var(--border-radius-s);
		background-color: var(--filter-bar-field-background-color);
		color: var(--color-text);

		&:focus-visible {

			@mixin focus-visible;
		}

		/* Hide default "X" icon in webkit browsers for search inputs */
		&::-webkit-search-cancel-button {
			display: none;
		}
	}
}

/* -------------------------------------------------------------------------
 * Filter Bar - Dropdown Facet
 *
 * A custom trigger and listbox over a screen-reader-only <select multiple>
 * that carries the form state.
 * ------------------------------------------------------------------------- */

.tribe-facet--dropdown .tribe-facet__dropdown {
	position: relative;
}

.tribe-facet--dropdown .tribe-facet__dropdown-trigger {
	--icon-size: 15px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--spacer-10);
	width: 100%;
	height: 50px;
	padding: 0 calc(var(--spacer-20) * 2 + var(--icon-size)) 0 var(--spacer-20);
	border: 1px solid var(--color-border);
	border-radius: var(--border-radius-s);
	background: var(--filter-bar-control-background-color);
	color: var(--color-text);
	cursor: pointer;
	text-align: left;

	&::after {
		content: '';
		display: block;
		width: var(--icon-size);
		height: var(--icon-size);
		position: absolute;
		top: 50%;
		right: var(--spacer-20);
		transform: translateY(-50%);
		mask: var(--icon-select-chevron) center no-repeat;
		mask-size: var(--icon-size);
		background-color: var(--color-border);
	}

	&:focus-visible {

		@mixin focus-visible;
	}
}

.tribe-facet--dropdown .tribe-facet__dropdown-trigger-label {
	min-width: 0;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

/*
 * Column layout so the search box and footer stay put while only the option
 * list scrolls. display is set here, so [hidden] needs saying explicitly.
 */
.tribe-facet--dropdown .tribe-facet__dropdown-popup {
	position: absolute;
	z-index: 20;
	top: calc(100% + var(--spacer-10));
	left: 0;
	right: 0;
	display: flex;
	flex-direction: column;
	max-height: 320px;
	border: 1px solid var(--color-border);
	border-radius: var(--border-radius-s);
	background: var(--filter-bar-control-background-color);

	&[hidden] {
		display: none;
	}
}

/* Full-bleed across the popup, so the field squares off and the wrapper's
 * bottom border does the separating. */
.tribe-facet--dropdown .tribe-facet__dropdown-search {

	@mixin facet-search-field;
	--icon-size: 20px;
	flex-shrink: 0;
	z-index: 2;
	border-bottom: 1px solid var(--color-border-secondary);
}

.tribe-facet--dropdown .tribe-facet__dropdown-search-input {
	width: 100%;
	height: 40px;
	padding: 0 calc(var(--spacer-20) * 2 + var(--icon-size)) 0 var(--spacer-20);
	border: 1px solid transparent;
	background-color: var(--filter-bar-field-background-color);
	color: var(--color-text);

	&:focus-visible {

		@mixin focus-visible;
	}

	&::-webkit-search-cancel-button {
		display: none;
	}
}

.tribe-facet--dropdown .tribe-facet__dropdown-list {
	flex: 1;
	margin: 0;
	padding: var(--spacer-10);
	list-style: none;
	overflow: auto;
	scrollbar-color: var(--filter-bar-scrollbar-thumb-color) var(--filter-bar-scrollbar-track-color);
	scrollbar-width: thin;
}

.tribe-facet--dropdown .tribe-facet__dropdown-empty {
	margin: 0;
	padding: var(--spacer-10) var(--spacer-20) var(--spacer-20);
	color: var(--color-text-secondary);
}

.tribe-facet--dropdown .tribe-facet__dropdown-option {
	position: relative;
	display: flex;
	align-items: center;
	gap: var(--spacer-10);
	width: 100%;
	padding: var(--spacer-10);
	border: 0;
	background: transparent;
	color: var(--color-text);
	text-align: left;
	cursor: pointer;

	&::before {

		@mixin facet-checkbox-box;
	}

	@media (--has-hover) {

		&:hover {

			@mixin facet-checkbox-hover-focus;
		}
	}

	&:focus-visible {

		@mixin facet-checkbox-hover-focus;
		@mixin focus-visible;
	}

	&[aria-selected="true"] {

		&::before {

			@mixin facet-checkbox-box-checked;
		}

		&::after {

			@mixin facet-checkbox-check;
			top: 50%;
			left: calc(var(--spacer-10) + 4px);
			transform: translateY(-50%);
		}

		.tribe-facet__label-text {
			font-weight: var(--font-weight-bold);
		}
	}
}

.tribe-facet--dropdown .tribe-facet__dropdown-footer {
	flex-shrink: 0;
	display: flex;
	align-items: center;
	gap: var(--spacer-20);
	padding: var(--spacer-10) var(--spacer-20);
	border-top: 1px solid var(--color-border-secondary);
}

.tribe-facet--dropdown .tribe-facet__dropdown-footer .tribe-facet__clear {
	margin-top: 0;
}

.tribe-facet--dropdown .tribe-facet__apply {
	margin-left: auto;
}
