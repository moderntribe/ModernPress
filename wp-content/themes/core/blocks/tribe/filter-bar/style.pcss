/* -------------------------------------------------------------------------
 *
 * Block - Filter Bar - Styles - FE / Editor
 *
 * ------------------------------------------------------------------------- */

@import './css/facets.pcss';

.b-filter-bar {
	--filter-bar-flyout-shadow: 0 -16px 24px 0 var(--color-black-20);
	container: filter-bar / inline-size;
}

.b-filter-bar__grid {

	.b-faceted-directory--filter-bar-top & {
		display: flex;
		flex-direction: column;
		gap: var(--spacer-20);

		@container filter-bar (min-width: 992px) {
			display: grid;
			grid-template-areas:
				"facet-1 facet-2 facet-3 search"
				"reset reset reset reset";
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: var(--spacer-30) var(--grid-gutter);

			.b-filter-bar__facet[data-grid-slot="facet-1"] {
				grid-area: facet-1;
			}

			.b-filter-bar__facet[data-grid-slot="facet-2"] {
				grid-area: facet-2;
			}

			.b-filter-bar__facet[data-grid-slot="facet-3"] {
				grid-area: facet-3;
			}

			.b-filter-bar__facet[data-grid-slot="search"] {
				grid-area: search;
			}

			.b-filter-bar__facet[data-grid-slot="reset"] {
				grid-area: reset;
			}
		}
	}
}

.b-faceted-directory--filter-bar-sidebar .b-filter-bar__facet {
	padding: var(--spacer-40) var(--grid-margin);
	border-top: 1px solid var(--color-border-secondary);

	&:first-child {
		border-top: 0;
	}

	@container faceted-directory (min-width: 992px) {
		padding: var(--spacer-40) 0;

		&:first-child {
			padding-top: 0;
			border-top: 0;
		}
	}
}

.b-filter-bar__facet-label {

	@mixin t-body;
	display: block;
	margin-bottom: var(--spacer-10);
	font-weight: var(--font-weight-bold);
}

/*
 * Top layout: pull the clear button up onto the label row. The label and the
 * button aren't siblings (the button comes from the facet renderer), so this is
 * absolute rather than a flex row.
 */
.b-faceted-directory--filter-bar-top .b-filter-bar__facet {
	position: relative;
}

.b-faceted-directory--filter-bar-top .b-filter-bar__facet-label {
	padding-right: var(--spacer-60);
}

.b-faceted-directory--filter-bar-top .tribe-facet:not(.tribe-facet--fancy-dropdown) .tribe-facet__clear {
	position: absolute;
	top: 0;
	right: 0;
	margin-top: 0;
}

.b-filter-bar__facet-summary {

	@mixin t-transparent-underline;
	@mixin t-display-xx-small;
	--accordion-icon-size: 16px;
	width: 100%;
	position: relative;
	padding: 0 calc(var(--spacer-20) + var(--accordion-icon-size)) 0 0;
	margin: 0;
	list-style: none;
	cursor: pointer;
	user-select: none;

	@media (--has-hover) {

		&:hover {

			@mixin t-transparent-underline-hover;
		}
	}

	&:focus:not(:focus-visible) {

		@mixin t-transparent-underline-hover;
	}

	&:focus-visible {

		@mixin focus-visible;
	}
}

.b-filter-bar__facet-summary::-webkit-details-marker,
.b-filter-bar__facet-summary::marker {
	display: none;
}

.b-filter-bar__facet-summary::after {
	content: "";
	display: block;
	width: var(--accordion-icon-size);
	height: var(--accordion-icon-size);
	position: absolute;
	right: 0;
	top: 50%;
	transform: translateY(-50%) rotate(90deg) !important;
	mask: var(--icon-chevron-right) center no-repeat;
	mask-size: contain;
	background-color: currentcolor;
	transition: var(--transition);
}

.b-filter-bar__facet--accordion[open] .b-filter-bar__facet-summary::after {
	transform: translateY(-50%) rotate(-90deg) !important;
}

.b-filter-bar__facet-content {
	padding-top: var(--spacer-40);
}

.b-filter-bar[data-filter-bar-position="sidebar"] .b-filter-bar__mobile-trigger {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--spacer-20);

	@container faceted-directory (min-width: 992px) {
		display: none;
	}
}

.b-filter-bar__trigger-btn {
	--trigger-icon-size: 24px;
	display: inline-flex;
	align-items: center;
	gap: var(--spacer-10);
	padding: 0;
	border: 0;
	background: none;
	cursor: pointer;
	color: var(--color-text);

	@media (--has-hover) {

		&:hover {

			@mixin filter-bar-flyout-toggle-hover-focus;
		}
	}

	&:focus:not(:focus-visible) {

		@mixin filter-bar-flyout-toggle-hover-focus;
	}

	&:focus-visible {

		@mixin focus-visible;
	}
}

.b-filter-bar__trigger-icon {
	display: block;
	width: var(--trigger-icon-size);
	height: var(--trigger-icon-size);
	flex-shrink: 0;
	background-color: currentcolor;
	mask: var(--icon-filter) center no-repeat;
	mask-size: contain;
}

.b-filter-bar__trigger-text {

	@mixin t-animated-underline;
	@mixin t-body;
	font-weight: var(--font-weight-bold);
}

.b-filter-bar__clear-wrap {
	display: inline-block;

	&[hidden] {
		display: none;
	}
}

.b-filter-bar__responsive-facets {
	min-inline-size: 0;
	margin: 0;
	padding: 0;
	border: 0;
}

.b-filter-bar__responsive-facets--sidebar {
	display: none;

	@container faceted-directory (min-width: 992px) {
		display: block;
	}
}

.b-filter-bar[data-filter-bar-position="sidebar"] .b-filter-bar__flyout {
	position: fixed;
	inset: calc(var(--spacer-wpadmin) + var(--spacer-40)) 0 0 0;
	z-index: 1000;
	display: flex;
	flex-direction: column;
	background-color: var(--color-white);
	box-shadow: var(--filter-bar-flyout-shadow);
	border-top-left-radius: var(--border-radius-l);
	border-top-right-radius: var(--border-radius-l);
	overflow: auto;
	visibility: hidden;
	opacity: 0;
	color: var(--color-black);
	transition: visibility 0.2s, opacity 0.2s;

	&[aria-hidden="false"].is-open {
		visibility: visible;
		opacity: 1;
	}

	@container faceted-directory (min-width: 992px) {
		display: none;
	}
}

.b-filter-bar__flyout-inner {
	display: flex;
	flex-direction: column;
	min-height: 100%;
	flex: 1;

	@container faceted-directory (min-width: 992px) {
		min-height: 0;
	}
}

.b-filter-bar__flyout-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--spacer-20);
	flex-shrink: 0;
	padding: var(--spacer-30) var(--grid-margin);
	border-bottom: 1px solid var(--color-border-secondary);

	@container faceted-directory (min-width: 992px) {
		display: none;
	}
}

.b-filter-bar__flyout-title {
	margin-top: 0;
	font-weight: var(--font-weight-bold);
}

.b-filter-bar__flyout-close {
	--close-icon-size: 24px;
	display: inline-flex;
	align-items: center;
	gap: var(--spacer-10);
	padding: 0;
	border: 0;
	background: none;
	cursor: pointer;
	color: var(--color-black);

	@media (--has-hover) {

		&:hover {

			@mixin filter-bar-flyout-close-hover-focus;
		}
	}

	&:focus:not(:focus-visible) {

		@mixin filter-bar-flyout-close-hover-focus;
	}

	&:focus-visible {

		@mixin focus-visible;
	}
}

.b-filter-bar__flyout-close-icon {
	display: block;
	width: var(--close-icon-size);
	height: var(--close-icon-size);
	flex-shrink: 0;
	background-color: currentcolor;
	mask: var(--icon-dismiss) center no-repeat;
	mask-size: contain;
}

.b-filter-bar__flyout-close-text {

	@mixin t-animated-underline;
	@mixin t-body;
	font-weight: var(--font-weight-bold);
}

.b-filter-bar__flyout-body {
	flex: 1;
	overflow: auto;
	scrollbar-color: var(--color-neutral-50) var(--color-neutral-30);
	scrollbar-width: thin;

	@container faceted-directory (min-width: 992px) {
		overflow: visible;
	}
}

.b-filter-bar__flyout-footer {
	flex-shrink: 0;
	display: flex;
	justify-content: center;
	align-items: center;
	padding: var(--spacer-30) var(--grid-margin);
	border-top: 1px solid var(--color-border-secondary);

	@container faceted-directory (min-width: 992px) {
		display: none;
	}
}

/* -------------------------------------------------------------------------
 * Facet controls
 * ------------------------------------------------------------------------- */

.tribe-facet--fancy-dropdown .tribe-facet__fancy {
	position: relative;
}

.tribe-facet--fancy-dropdown .tribe-facet__fancy-trigger {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: var(--spacer-10);
	width: 100%;
	min-height: 48px;
	padding: var(--spacer-10) var(--spacer-20);
	border: 1px solid var(--color-border-secondary);
	border-radius: var(--border-radius-s);
	background: var(--color-white);
	cursor: pointer;
	text-align: left;
}

/* Always one line, however many options are chosen. */
.tribe-facet--fancy-dropdown .tribe-facet__fancy-trigger-label {
	min-width: 0;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.tribe-facet--fancy-dropdown .tribe-facet__fancy-list {
	position: absolute;
	z-index: 20;
	top: calc(100% + var(--spacer-10));
	left: 0;
	right: 0;
	margin: 0;
	padding: var(--spacer-10);
	list-style: none;
	border: 1px solid var(--color-border-secondary);
	border-radius: var(--border-radius-s);
	background: var(--color-white);
	max-height: 320px;
	overflow: auto;
}

.tribe-facet--fancy-dropdown .tribe-facet__fancy-option {
	display: block;
	width: 100%;
	padding: var(--spacer-10);
	border: 0;
	background: transparent;
	text-align: left;
	cursor: pointer;

	&[aria-selected="true"] {
		font-weight: var(--font-weight-bold);
	}
}

/* Sticks to the bottom of the scrolling list so options pass behind it. */
.tribe-facet--fancy-dropdown .tribe-facet__fancy-footer {
	display: flex;
	align-items: center;
	gap: var(--spacer-20);
	position: sticky;
	bottom: calc(var(--spacer-10) * -1);
	margin: var(--spacer-10) calc(var(--spacer-10) * -1) calc(var(--spacer-10) * -1);
	padding: var(--spacer-20);
	border-top: 1px solid var(--color-border-secondary);
	background: var(--color-white);
}

.tribe-facet--fancy-dropdown .tribe-facet__fancy-footer .tribe-facet__clear {
	margin-top: 0;
}

/* Right-aligned whether or not the clear button is showing. */
.tribe-facet--fancy-dropdown .tribe-facet__apply {
	margin-left: auto;
}

.tribe-facet--fancy-dropdown .tribe-facet__select--fancy {
	position: absolute;
	opacity: 0;
	pointer-events: none;
	width: 1px;
	height: 1px;
}
