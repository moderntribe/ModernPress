parameters:
	level: 5
	paths:
		- wp-content/themes/core/
		- wp-content/plugins/core/
		- wp-content/mu-plugins/
	excludePaths:
		- vendor
		- wp-content/themes/core/dist/ (?)
	bootstrapFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
	scanFiles:
		# php-stubs/wordpress-stubs v7.1.0 does not include the Icons API declarations yet.
		# Read core's own declarations until the stubs catch up.
		- wp-includes/icons.php
	tmpDir: .phpstan-cache/
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		- '#^Function yoast_get_primary_term_id not found.$#'

	# Unfortunately, DocBlocks can't be relied upon in WordPress.
	treatPhpDocTypesAsCertain: false
